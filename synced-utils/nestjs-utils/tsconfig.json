{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    // Nest's decorators are the legacy kind, and its DI reads the `design:paramtypes` metadata.
    // Consumers need both flags too, and a runtime that honours them (swc-node) — Node's own type
    // stripping does neither.
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": ["src", "example"]
}
