# tx-payees in test mode (`devtooie --mode test`). Package scope: these override the workspace
# files for this package only. The secrets in .env.local still load in every mode.

# Its own replica file. The replica mirrors whatever DATABASE_URL points at, and a sync deletes
# every local row the database no longer has — so sharing storage/replica.sqlite with development
# would empty the development replica the first time test mode synced against the test database.
REPLICA_DB_PATH=storage/replica-test.sqlite

# No agents in test mode: they run on the owner's Claude subscription and research real merchants.
# Exact and rule matching still run.
TX_AI_ENABLED=false
TX_LOCATION_ENABLED=false
