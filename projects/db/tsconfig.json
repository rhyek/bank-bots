{
  // @bank-bots/db is consumed as TypeScript source (its `exports` point at src), so there's no
  // emit — consumers (scrape-txs via swc-node, the web app via Vite) transpile it. These options
  // mirror scrape-txs so the lib type-checks identically in its own check and in consumers'.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts"]
}
