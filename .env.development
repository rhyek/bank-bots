# bank-bots — port block 25 of ~/Dev/reserved_port_ranges.txt (22250–22299).
#
# Loaded by DEVTOOIE, not direnv: devtooie resolves .env / .env.local / .env.<mode> /
# .env.<mode>.local at workspace and package scope and injects them into each package's process.
# There is deliberately no .envrc — a variable direnv exported into the shell would OUTRANK this
# file (ambient environment wins) and freeze for the session, so editing this file would silently
# do nothing until `direnv reload`.
#
# Reach a package's environment from a shell with:  devtooie cmd -p <package> -- <command>
#
# This is the DEVELOPMENT half of the block (22250–22274); .env.test mirrors every port at +25
# (22275–22299). Public dev URLs: https://<subdomain>.${ROOT_DOMAIN} — devtooie's dev reverse proxy
# (DEV_REVERSE_PROXY_PORT) routes by subdomain behind the machine's Caddy
# (~/Dev/personal/workstation; `localdev add` registers ROOT_DOMAIN there).
#
# Each *_PORT is read in exactly one place: that package's `port` in devtooie.config.ts, which
# devtooie hands to the process as PORT. Never put a bare PORT= in any env file.
ROOT_DOMAIN=bank-bots-dev.workstation.rhyek.com
DEV_REVERSE_PROXY_PORT=22250
SCRAPE_TXS_PORT=22251
TX_PAYEES_PORT=22252
WEB_PORT=22253
# Allocated, not in use: development still runs against the real database on Supabase
# (DATABASE_URL in .env.development.local), so the `db` service of docker-compose.yaml is disabled in this mode
# (devtooie.config.ts) and the rest of its DB_* settings live only in .env.test.
DB_PORT=22254
