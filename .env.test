# bank-bots — port block 25 of ~/Dev/reserved_port_ranges.txt (22250–22299): the TEST half
# (22275–22299). Every port is its .env.development twin + 25. Loaded by devtooie in `--mode test`
# (modes are exclusive: this file, never .env.development), so it carries everything test mode
# needs that is not a secret.
ROOT_DOMAIN=bank-bots-test.workstation.rhyek.com
DEV_REVERSE_PROXY_PORT=22275
SCRAPE_TXS_PORT=22276
TX_PAYEES_PORT=22277
WEB_PORT=22278

# The test database: the `db` service of docker-compose.yaml, which devtooie's `infra` brings up.
# These are read twice: by Compose, to configure the container and publish its port, and by the
# apps, through DATABASE_URL — built here by interpolation so the pieces are stated once. The
# credentials are throwaway ones for a loopback-only container.
#
# The real database's URL is in .env.development.local, a file test mode never loads, so this is
# the only DATABASE_URL there is here. (A value exported in the shell would still outrank it:
# the seed and the web tests each refuse anything that is not a local database; the migration step
# does not check.)
DB_HOST=localhost
DB_PORT=22279
DB_USER=bank_bots
DB_PASSWORD=bank_bots
DB_NAME=bank_bots
DATABASE_URL="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
