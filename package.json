{
  "name": "bank-bots",
  "private": true,
  "type": "module",
  "description": "Workspace root — shared TypeScript lint/format toolchain for every package in this repo.",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "prepare": "simple-git-hooks",
    "dev": "devtooie",
    "format:check": "oxfmt --check"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@rhyek/oxc-config": "workspace:*",
    "devtooie": "link:../published/devtooie/packages/devtooie"
  }
}
